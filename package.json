{
  "name": "@gitify-app/kde",
  "version": "1.0.0",
  "private": true,
  "description": "KWin script that positions Gitify beside the KDE Plasma panel",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "lint:ci": "oxlint --format=github",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:live": "python3 scripts/test-live.py",
    "bundle": "bash scripts/bundle.sh"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "engines": { "node": ">=24" },
  "devDependencies": {
    "oxlint": "1.90.0"
  }
}
